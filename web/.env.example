# Variaveis do frontend. Precisam do prefixo VITE_ para o Vite expor ao bundle.
#
# ATENCAO: no Vite estas variaveis sao resolvidas em BUILD TIME, nao em runtime.
# Elas viram texto literal dentro do JavaScript gerado. Por isso o Dockerfile do
# frontend as recebe como build args, e nao como environment do container.

# O login vai direto ao Auth Service, sem passar pelo Main API.
VITE_AUTH_URL=http://localhost:3001

# Todo o resto passa pelo Main API.
VITE_API_URL=http://localhost:3000
