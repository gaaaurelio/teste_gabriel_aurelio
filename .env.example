# =============================================================================
# Variaveis usadas pelo docker-compose.yml
# =============================================================================
# O docker-compose.yml ja define valores default para todas elas, entao
# `docker compose up --build` funciona sem criar este arquivo. Copie para .env
# apenas se quiser sobrescrever algo:
#
#   cp .env.example .env
#
# Os valores abaixo sao de desenvolvimento local e estao propositalmente no
# repositorio para que a avaliacao rode com um comando so. Em producao eles
# viriam de um gerenciador de segredos, nunca de arquivo versionado.

# --- Postgres do Auth Service -------------------------------------------------
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=auth_pwd_dev
POSTGRES_AUTH_DB=auth_db

# --- Postgres do Main API -----------------------------------------------------
POSTGRES_MAIN_USER=main_user
POSTGRES_MAIN_PASSWORD=main_pwd_dev
POSTGRES_MAIN_DB=main_db

# --- Segredo do JWT ------------------------------------------------------------
# Compartilhado entre os dois servicos: o Auth assina com ele e e o que permite
# ao Auth reconhecer, no /auth/validate, um token que ele mesmo emitiu.
JWT_SECRET=dev-jwt-secret-troque-isto-em-producao
JWT_EXPIRES_IN=1h

# --- Credencial de servico (S2S) ----------------------------------------------
# Identifica o Main API perante o Auth Service. E uma credencial do *servico*,
# distinta do JWT do usuario final.
INTERNAL_API_KEY=dev-internal-api-key-troque-isto-em-producao

# --- Delay artificial exigido pelo enunciado ----------------------------------
STATUS_UPDATE_DELAY_MS=1500

# --- Timeout da chamada Main API -> Auth Service ------------------------------
AUTH_VALIDATE_TIMEOUT_MS=2000
